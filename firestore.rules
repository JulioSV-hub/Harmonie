rules_version = '2';

// Regras de acesso do Firestore do Harmonie.
// Público: lê conteúdo publicado e cria pedidos de agendamento.
// Admin (usuário com documento em /admins/{uid}): lê e altera tudo.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function optionalString(data, field, maxSize) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxSize);
    }

    function validAgendamento() {
      let d = request.resource.data;
      return d.keys().hasOnly(['nome', 'email', 'data', 'horario', 'modalidade', 'motivo', 'status', 'criadoEm'])
        && d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 100
        && d.data is string && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.horario is string && d.horario.matches('^[0-9]{2}:[0-9]{2}$')
        && optionalString(d, 'email', 120)
        && optionalString(d, 'modalidade', 60)
        && optionalString(d, 'motivo', 1000)
        && d.status == 'pendente'
        && d.criadoEm == request.time;
    }

    // Textos e dados do site (config/site) e atividades (config/atividades).
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /videos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Rascunhos (publicado != true) só são visíveis ao admin.
    match /artigos/{docId} {
      allow read: if isAdmin() || resource.data.publicado == true;
      allow write: if isAdmin();
    }

    // Pedidos contêm dados pessoais: o público só cria; ninguém além do admin lê.
    match /agendamentos/{docId} {
      allow create: if validAgendamento();
      allow read, update, delete: if isAdmin();
    }

    // Lista de administradores: criada manualmente no Console do Firebase.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
